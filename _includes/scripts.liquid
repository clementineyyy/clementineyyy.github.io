<!-- GoatCounter -->
{% if site.goatcounter_endpoint %}
  {% comment %}
    Pageviews are reported directly instead of via count.js: that script's sendBeacon path never
    reached GoatCounter here, while same-origin fetch to the same host works fine. Kept self-hosted
    (assets/js/count.js) is no longer needed, so nothing from the blocked gc.zgo.at CDN is loaded.
    Per-post counts are read from the JSON API, which needs an API key (account menu -> API); that
    key ships in this public JS, so use a read-only key and revoke it under Settings -> API if it leaks.
  {% endcomment %}
  {% assign gc_host = site.goatcounter_endpoint | replace: 'https://', '' | replace: 'http://', '' | replace: '/count', '' %}
  {% assign gc_key = site.goatcounter_api_key | default: '' %}
  <script>
    window.afPageviews = { host: "{{ gc_host }}", key: "{{ gc_key }}", baseurl: "{{ site.baseurl }}" };
    (function () {
      var cfg = window.afPageviews;

      // Report the pageview. Localhost / LAN addresses are skipped so local previews don't
      // pollute real numbers.
      if (!/(^localhost$|^127\.|^10\.|^192\.168\.)/.test(window.location.hostname)) {
        var hit =
          "https://" + cfg.host + "/count?p=" + encodeURIComponent(window.location.pathname) +
          "&t=" + encodeURIComponent(document.title) +
          "&s=" + window.screen.width +
          "&rnd=" + Math.random().toString(36).substr(2, 5);
        try {
          fetch(hit, { keepalive: true, mode: "no-cors", credentials: "omit" }).catch(function () {});
        } catch (e) {}
      }
      var els = [].slice.call(document.querySelectorAll("[data-pv]"));
      if (!els.length || !cfg.key) return;
      var end = new Date();
      var start = new Date(end.getTime() - 1000 * 60 * 60 * 24 * 365 * 5);
      function iso(d) {
        return d.toISOString().slice(0, 13) + ":00:00Z";
      }
      var url =
        "https://" + cfg.host + "/api/v0/stats/hits?path_by_name=true&limit=500" +
        "&start=" + encodeURIComponent(iso(start)) +
        "&end=" + encodeURIComponent(iso(end));
      fetch(url, { headers: { Authorization: "Bearer " + cfg.key } })
        .then(function (r) {
          if (!r.ok) throw new Error("gc " + r.status);
          return r.json();
        })
        .then(function (d) {
          // GoatCounter stores paths with any trailing slash stripped, so index both forms.
          var map = {};
          ((d && d.hits) || []).forEach(function (h) {
            map[h.path] = h.count;
            map[h.path + "/"] = h.count;
          });
          els.forEach(function (el) {
            var p = el.getAttribute("data-pv") || window.location.pathname;
            var n = map[p];
            if (typeof n !== "number" && cfg.baseurl && p.indexOf(cfg.baseurl) === 0) n = map[p.slice(cfg.baseurl.length)];
            if (typeof n !== "number") n = 0;
            el.innerHTML = "&nbsp;&nbsp;&middot;&nbsp;&nbsp;&#128065;&nbsp;" + n + "&nbsp;views";
          });
        })
        .catch(function () {});
    })();
  </script>
{% endif %}