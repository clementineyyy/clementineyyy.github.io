{% assign lang = site.lang | split: '-' | first %}

{% case lang %}
  {% when 'pt' %}
    {% assign lang = site.lang %}
  {% when 'zh' %}
    {% assign lang_last = site.lang | split: '-' | last %}
    {% case lang_last %}
      {% when 'cn', 'sg', 'my', 'hans' %}
        {% assign lang = 'cn' %}
      {% when 'tw', 'hk', 'mo', 'hant' %}
        {% assign lang = 'zh-tw' %}
    {% endcase %}
{% endcase %}

{% comment %}
  Defaults to the maintained github-stats-extended fork; override via `external_services.github_readme_stats_url` to self-host.
{% endcomment %}
{% assign stats_url = site.external_services.github_readme_stats_url | default: 'https://github-stats-extended.vercel.app' %}

{% comment %}
  Local override of the gem include. This deployment rejects `cache_seconds` (it renders
  "Cannot read properties of undefined (reading 'user')"), but accepts `cache_buster`. The value is
  the build timestamp so the upstream cached copy is regenerated on every build instead of
  serving a months-old snapshot.
{% endcomment %}
{% assign stats_buster = site.time | date: "%s" %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.username }}">
    <img
      class="only-light w-100"
      alt="{{ include.username }}"
      src="{{ stats_url }}/api/?username={{ include.username }}&theme={{ site.repo_theme_light }}&locale={{ lang }}&show_icons=true&cache_buster={{ stats_buster }}"
      onerror="this.closest('.repo').style.display='none'"
    >
    <img
      class="only-dark w-100"
      alt="{{ include.username }}"
      src="{{ stats_url }}/api/?username={{ include.username }}&theme={{ site.repo_theme_dark }}&locale={{ lang }}&show_icons=true&cache_buster={{ stats_buster }}"
      onerror="this.closest('.repo').style.display='none'"
    >
  </a>
</div>